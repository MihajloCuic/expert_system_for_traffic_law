<?xml version="1.0" encoding="UTF-8"?>
<kmodule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://jboss.org/kie/6.0.0/kmodule">

    <!-- Module 1 - Fine calculation
         CEP mode required for the 24-month penalty point window (PointPenalty events). -->
    <kbase name="sanctionsKBase" packages="sanctions" eventProcessingMode="stream">
        <ksession name="sanctionsKsession" clockType="realtime"/>
    </kbase>

    <!-- Module 2 - Fault determination
         CEP mode required for time-based events (ParticipantAction). -->
    <kbase name="faultKBase" packages="fault" eventProcessingMode="stream">
        <ksession name="faultKsession" clockType="realtime"/>
    </kbase>

</kmodule>
