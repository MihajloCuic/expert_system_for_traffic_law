            .lawArticle("ZOBS art. 36 (penal art. 332)")
            .severity(Severity.MODERATE)
            .fine(10000, 20000)
            .points(2)
            .drivingBanDays(90)
            .build();
        s.addExplanation("[L1] Wrong way on one-way street -> 10-20k RSD + 2 points + 3 months ban");
        insert(s);
        System.out.println("[FIRED] 34 Wrong way on one-way street");
end

