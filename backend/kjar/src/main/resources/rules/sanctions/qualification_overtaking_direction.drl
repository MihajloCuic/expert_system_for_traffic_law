package sanctions;

import com.ftn.sbnz.model.sanctions.Violation;
import com.ftn.sbnz.model.sanctions.Sanction;
import com.ftn.sbnz.model.sanctions.ViolationType;
import com.ftn.sbnz.model.sanctions.Severity;

// ============================================================
// LAYER 1 - OVERTAKING & DIRECTION (rules 30-38)
// ============================================================

// --- Overtaking (30-33) ---

rule "30 Overtaking across solid line"
    salience 7
    when
        $v : Violation(type == ViolationType.OVERTAKING_SOLID_LINE)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 55 par. 3 pt. 15 (penal art. 331)")
            .severity(Severity.MAJOR)
            .fine(20000, 40000)
            .prison(0, 30)
            .alternativePenalty(true)
            .points(6)
            .drivingBanDays(90)
            .build();
        s.addExplanation("[L1] Overtaking across solid line -> 20-40k RSD OR prison <= 30 days + 6 points + 3 months ban");
        insert(s);
        System.out.println("[FIRED] 30 Overtaking across solid line");
end

rule "31 Overtaking at pedestrian crossing"
    salience 7
    when
        $v : Violation(type == ViolationType.OVERTAKING_AT_CROSSING)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 55 par. 3 pt. 9 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Overtaking at pedestrian crossing -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 31 Overtaking at pedestrian crossing");
end

