package sanctions;

import com.ftn.sbnz.model.Driver;
import com.ftn.sbnz.model.ActivePointsSnapshot;
import com.ftn.sbnz.model.LicenseRevocation;

import java.time.LocalDate;

// ============================================================
// LAYER 5 - LICENSE REVOCATION
//
// Based on the active-points snapshot produced by Layer 4 (CEP):
//   - 18+ points  -> revoke STANDARD license
//   - 9+ points   -> revoke PROBATIONARY license
//
// A driver is treated as probationary when:
//   - now < licenseIssuedAt + 2 years, OR
//   - the driver obtained the license before turning 19 AND
//     has not yet turned 21.
// (Helper Driver.isProbationary() encapsulates this.)
//
// "not LicenseRevocation(driver == $d)" prevents double-revocation.
// ============================================================

rule "License revocation: standard license (18+ points)"
    salience -30
    when
        $d : Driver()
        eval($d.isProbationary(LocalDate.now()) == false)
        $snap : ActivePointsSnapshot(driver == $d, activePoints >= 18)
        not LicenseRevocation(driver == $d)
    then
        LicenseRevocation rev = new LicenseRevocation(
            $d, LocalDate.now(),
            $snap.getActivePoints(),
            false,
            "Active penalty points >= 18 within last 24 months (standard license)");
        insert(rev);
        System.out.println("[FIRED] L5 LICENSE REVOKED (standard): "
            + $d.getFullName() + " - " + $snap.getActivePoints() + " active points");
end

rule "License revocation: probationary license (9+ points)"
    salience -30
    when
        $d : Driver()
        eval($d.isProbationary(LocalDate.now()) == true)
        $snap : ActivePointsSnapshot(driver == $d, activePoints >= 9)
        not LicenseRevocation(driver == $d)
    then
        LicenseRevocation rev = new LicenseRevocation(
            $d, LocalDate.now(),
            $snap.getActivePoints(),
            true,
            "Active penalty points >= 9 within last 24 months (probationary license)");
        insert(rev);
        System.out.println("[FIRED] L5 LICENSE REVOKED (probationary): "
            + $d.getFullName() + " - " + $snap.getActivePoints() + " active points");
end
