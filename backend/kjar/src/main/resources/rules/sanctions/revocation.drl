package sanctions;

import com.ftn.sbnz.model.sanctions.Driver;
import com.ftn.sbnz.model.sanctions.ActivePointsSnapshot;
import com.ftn.sbnz.model.sanctions.LicenseRevocation;

import java.time.LocalDate;

// ============================================================
// LAYER 8 - LICENSE REVOCATION
//
// Based on the active-points snapshot produced by Layer 7 (CEP):
//   - 18+ points  -> revoke STANDARD license
//   - 9+ points   -> revoke PROBATIONARY license
//
// Probationary status is read directly from the DrivingLicense entity
// (Driver.license.type == LicenseType.PROBATIONARY). Helper
// {@code Driver.isProbationary()} returns false when the driver has no
// license at all, so neither rule fires in that case - a license-less
// driver is already sanctioned via the NO_LICENSE rule.
//
// "not LicenseRevocation(driver == $d)" prevents double-revocation.
// salience 0 (default) - the last layer to fire in the chain.
// ============================================================

rule "License revocation: standard license (18+ points)"
    salience 0
    when
        $d : Driver()
        eval($d.isProbationary() == false)
        $snap : ActivePointsSnapshot(driver == $d, activePoints >= 18)
        not LicenseRevocation(driver == $d)
    then
        LicenseRevocation rev = new LicenseRevocation(
            $d, LocalDate.now(),
            $snap.getActivePoints(),
            false,
            "Active penalty points >= 18 within last 24 months (standard license)");
        insert(rev);
        System.out.println("[FIRED] L8 LICENSE REVOKED (standard): "
            + $d.getFullName() + " - " + $snap.getActivePoints() + " active points");
end

rule "License revocation: probationary license (9+ points)"
    salience 0
    when
        $d : Driver()
        eval($d.isProbationary() == true)
        $snap : ActivePointsSnapshot(driver == $d, activePoints >= 9)
        not LicenseRevocation(driver == $d)
    then
        LicenseRevocation rev = new LicenseRevocation(
            $d, LocalDate.now(),
            $snap.getActivePoints(),
            true,
            "Active penalty points >= 9 within last 24 months (probationary license)");
        insert(rev);
        System.out.println("[FIRED] L8 LICENSE REVOKED (probationary): "
            + $d.getFullName() + " - " + $snap.getActivePoints() + " active points");
end
