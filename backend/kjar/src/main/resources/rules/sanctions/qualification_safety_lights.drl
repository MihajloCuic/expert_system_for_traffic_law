package sanctions;

import com.ftn.sbnz.model.Violation;
import com.ftn.sbnz.model.Sanction;
import com.ftn.sbnz.model.ViolationType;
import com.ftn.sbnz.model.Severity;

// ============================================================
// LAYER 1 - SAFETY (pojas/telefon/pesaci/deca) (39-42)
//           + LIGHTS (43-47)
// ============================================================

// --- Safety (39-42) ---

rule "39 Phone usage while driving"
    salience 7
    when
        $v : Violation(type == ViolationType.PHONE_USAGE)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 28 par. 1 (penal art. 332a)")
            .severity(Severity.PETTY)
            .fixedFine(10000)
            .build();
        s.addExplanation("[L1] Phone usage while driving -> 10.000 RSD");
        insert(s);
        System.out.println("[FIRED] 39 Phone usage");
end

rule "40 No seatbelt"
    salience 7
    when
        $v : Violation(type == ViolationType.NO_SEATBELT)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 30 par. 1 (penal art. 332a)")
            .severity(Severity.PETTY)
            .fixedFine(10000)
            .build();
        s.addExplanation("[L1] No seatbelt -> 10.000 RSD");
        insert(s);
        System.out.println("[FIRED] 40 No seatbelt");
end

rule "41 Pedestrian negligence on crossing"
    salience 7
    when
        $v : Violation(type == ViolationType.PEDESTRIAN_NEGLIGENCE)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 99 par. 3 (penal art. 332)")
            .severity(Severity.MODERATE)
            .fine(10000, 20000)
            .points(3)
            .build();
        s.addExplanation("[L1] Pedestrian negligence on crossing -> 10-20k RSD + 3 points");
        insert(s);
        System.out.println("[FIRED] 41 Pedestrian negligence");
end

rule "42 Child 3-12yo in front seat"
    salience 7
    when
        $v : Violation(type == ViolationType.CHILD_IN_FRONT_SEAT)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 31 par. 1-4 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Child 3-12 yo in front seat -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 42 Child in front seat");
end

// --- Lights (43-47) ---

rule "43 No day lights during the day"
    salience 7
    when
        $v : Violation(type == ViolationType.NO_DAY_LIGHTS)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 77 par. 1 (penal art. 334)")
            .severity(Severity.MINIMAL)
            .fixedFine(3000)
            .build();
        s.addExplanation("[L1] No day lights during the day -> 3.000 RSD");
        insert(s);
        System.out.println("[FIRED] 43 No day lights");
end

rule "44 Improper use of night lights"
    salience 7
    when
        $v : Violation(type == ViolationType.IMPROPER_NIGHT_LIGHTS)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 77 par. 3 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Improper use of night lights -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 44 Improper night lights");
end

rule "45 Using only position lights at night"
    salience 7
    when
        $v : Violation(type == ViolationType.ONLY_POSITION_LIGHTS_AT_NIGHT)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 77 par. 2 (penal art. 332a)")
            .severity(Severity.PETTY)
            .fixedFine(10000)
            .points(6)
            .drivingBanDays(90)
            .build();
        s.addExplanation("[L1] Using only position lights at night -> 10.000 RSD + 6 points + 3 months ban");
        insert(s);
        System.out.println("[FIRED] 45 Only position lights at night");
end

rule "46 No lights in fog"
    salience 7
    when
        $v : Violation(type == ViolationType.NO_LIGHTS_IN_FOG)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 77 par. 1 (penal art. 332)")
