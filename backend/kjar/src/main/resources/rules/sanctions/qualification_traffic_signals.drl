package sanctions;

import com.ftn.sbnz.model.sanctions.Violation;
import com.ftn.sbnz.model.sanctions.ViolationContext;
import com.ftn.sbnz.model.sanctions.Sanction;
import com.ftn.sbnz.model.sanctions.ViolationType;
import com.ftn.sbnz.model.sanctions.Severity;

// ============================================================
// LAYER 1 - SIGNALIZATION & RIGHT OF WAY (rules 25-29)
// ============================================================

rule "25 Red light violation"
    salience 7
    when
        $v : Violation(type == ViolationType.RED_LIGHT)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 142 par. 2 (penal art. 331)")
            .severity(Severity.MAJOR)
            .fine(20000, 40000)
            .prison(0, 30)
            .alternativePenalty(true)
            .points(6)
            .drivingBanDays(90)
            .build();
        s.addExplanation("[L1] Red light violation -> 20-40k RSD OR prison <= 30 days + 6 points + 3 months ban");
        insert(s);
        System.out.println("[FIRED] 25 Red light violation");
end

rule "26 Stop sign ignored"
    salience 7
    when
        $v : Violation(type == ViolationType.STOP_SIGN_IGNORED)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 132 par. 3 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Stop sign ignored -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 26 Stop sign ignored");
end

rule "27 Yield sign ignored"
    salience 7
    when
        $v : Violation(type == ViolationType.YIELD_SIGN_IGNORED)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 132 par. 3 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Yield sign ignored -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 27 Yield sign ignored");
end

rule "28 Right of way at intersection"
    salience 7
    when
        $v : Violation(type == ViolationType.RIGHT_OF_WAY_AT_INTERSECTION)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 47 (penal art. 332)")
            .severity(Severity.MODERATE)
            .fine(10000, 20000)
            .points(6)
            .build();
        s.addExplanation("[L1] Right of way at intersection -> 10-20k RSD + 6 points");
        insert(s);
        System.out.println("[FIRED] 28 Right of way at intersection");
end

rule "29a Right of way for pedestrian (adult)"
    salience 7
    when
        $v : Violation(type == ViolationType.RIGHT_OF_WAY_FOR_PEDESTRIAN)
        not ViolationContext(violation == $v, pedestrianIsChild == true)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 99 par. 4 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Right of way for pedestrian (adult) on crossing -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 29a Right of way for pedestrian (adult)");
end

rule "29b Right of way for pedestrian (child < 12)"
    salience 7
    when
        $v : Violation(type == ViolationType.RIGHT_OF_WAY_FOR_PEDESTRIAN)
        ViolationContext(violation == $v, pedestrianIsChild == true)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 99 par. 4 (penal art. 332, child aggravating)")
            .severity(Severity.MODERATE)
            .fine(10000, 20000)
            .build();
        s.addExplanation("[L1] Right of way for child pedestrian (< 12 yo) on crossing -> 10-20k RSD (aggravated)");
        insert(s);
        System.out.println("[FIRED] 29b Right of way for pedestrian (child)");
end
