package sanctions;

import com.ftn.sbnz.model.Violation;
import com.ftn.sbnz.model.Sanction;
import com.ftn.sbnz.model.ViolationType;
import com.ftn.sbnz.model.Location;
import com.ftn.sbnz.model.Severity;

// ============================================================
// LAYER 1 - VIOLATION QUALIFICATION
// Derives base fine and penalty points from a raw Violation.
// ============================================================

rule "Speeding 21-40 km/h in urban area"
    when
        $v : Violation(type == ViolationType.SPEEDING,
                       location == Location.URBAN,
                       speedOverLimitKmH >= 21, speedOverLimitKmH <= 40)
    then
        Sanction s = new Sanction($v, 15000, 5,
            "TSL art. 332 par. 1 pt. 4", Severity.MAJOR);
        s.addExplanation("[Layer 1] Speeding 21-40 km/h in urban area -> 15000 RSD, 5 points");
        insert(s);
        System.out.println("[FIRED] Speeding 21-40 km/h in urban area");
end

rule "Alcohol 0.5-1.0 per mille"
    when
        $v : Violation(type == ViolationType.ALCOHOL,
                       bloodAlcoholLevel >= 0.50, bloodAlcoholLevel < 1.00)
    then
        Sanction s = new Sanction($v, 30000, 6,
            "TSL art. 330 par. 1", Severity.MAJOR);
        s.addExplanation("[Layer 1] Driving under influence of alcohol 0.5-1.0 per mille -> 30000 RSD, 6 points");
        insert(s);
        System.out.println("[FIRED] Alcohol 0.5-1.0 per mille");
end
