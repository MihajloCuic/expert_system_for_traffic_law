package sanctions;

import com.ftn.sbnz.model.sanctions.LicenseRevocation;
import com.ftn.sbnz.model.sanctions.Sanction;
import com.ftn.sbnz.model.sanctions.Severity;
import com.ftn.sbnz.model.sanctions.Violation;
import com.ftn.sbnz.model.sanctions.ViolationType;

// ============================================================
// LAYER 1 (explicit) and LAYER 2 (auto-derived)
//   - DRIVING DURING ACTIVE BAN (ZOBS art. 330 par. 1 pt. 8)
//
// Two complementary paths produce this Sanction:
//
//   (a) An officer explicitly logs a DRIVING_DURING_BAN violation.   (Layer 1)
//
//   (b) The driver already has a PRE-EXISTING LicenseRevocation       (Layer 2)
//       (loaded from the database, id != null) AND commits any other
//       violation. The act of driving despite an existing ban is itself
//       a separate offense under ZOBS art. 330 par. 1 pt. 8.
//
// The "id != null" filter is critical: we must NOT apply this rule to a
// LicenseRevocation that was just created in the current session as a
// CONSEQUENCE of accumulated points, because the driver could not have
// been "driving during a ban" that did not exist at the time of driving.
//
// The "not Sanction(...)" guard ensures at most one Sanction with this
// article is produced per Violation, regardless of which path matched.
// ============================================================

rule "Driving during active license ban (explicit)"
    salience 7
    when
        $v : Violation(type == ViolationType.DRIVING_DURING_BAN)
        not Sanction(violation == $v, lawArticle matches ".*330.*pt\\. 8.*")
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 330 par. 1 pt. 8 (driving during active ban)")
            .severity(Severity.SEVERE)
            .fine(100000, 120000)
            .prison(15, 30)
            .alternativePenalty(true)
            .points(14)
            .drivingBanDays(240)
            .build();
        s.addExplanation("[L1] Driving during active ban -> 100-120k RSD OR prison >= 15 days + 14 points + 8 months ban");
        insert(s);
        System.out.println("[FIRED] Driving during active ban (explicit)");
end

rule "Driving during active license ban (auto-derived from pre-existing revocation)"
    salience 6  // Layer 2 - fires after Layer 1 qualification (7), before Layer 3 dedup (5)
    when
        $v : Violation($driver : driver)
        // `exists` so a driver with N historical revocations still produces
        // ONE activation, not N. id != null filters out revocations created
        // earlier in this session by Layer 8 (those are CONSEQUENCES of the
        // current violations, not pre-existing bans the driver was breaking).
        exists LicenseRevocation(driver == $driver, id != null)
        not Sanction(violation == $v, lawArticle matches ".*330.*pt\\. 8.*")
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 330 par. 1 pt. 8 (driving during active ban - auto-derived)")
            .severity(Severity.SEVERE)
            .fine(100000, 120000)
            .prison(15, 30)
            .alternativePenalty(true)
            .points(14)
            .drivingBanDays(240)
            .build();
        s.addExplanation("[L2] Driver has a pre-existing LicenseRevocation -> driving itself is a separate offense under ZOBS art. 330 par. 1 pt. 8 (100-120k RSD + prison + 14 points + 8 months ban)");
        insert(s);
        System.out.println("[FIRED] Driving during active ban (auto-derived from pre-existing revocation)");
end
