package sanctions;

import com.ftn.sbnz.model.sanctions.Violation;
import com.ftn.sbnz.model.sanctions.Sanction;
import com.ftn.sbnz.model.sanctions.ViolationType;
import com.ftn.sbnz.model.sanctions.Severity;

// ============================================================
// LAYER 1 - ALCOHOL & SUBSTANCE (rules 18-24)
//
// Rules 18-23 (driving under the influence of alcohol, ZOBS art. 187
// par. 2, 4) have been migrated to a Drools Template:
//
//   - rules/templates/alcohol_by_bac.drt  (+ .csv)  -> 6 rules
//       BAC ranges: 0.21-0.50, 0.51-0.80, 0.81-1.20, 1.21-1.60,
//                   1.61-2.00, > 2.00 (reckless driving)
//
// Rule 24 (REFUSING_ALCO_TEST) below is intentionally NOT in the
// template because it matches a different ViolationType
// (REFUSING_ALCO_TEST, not ALCOHOL) and has no BAC parameter -
// making it structurally distinct from the BAC tariff.
// ============================================================

rule "24 Refusing alcohol test"
    salience 7
    when
        $v : Violation(type == ViolationType.REFUSING_ALCO_TEST)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 280 (penal art. 330)")
            .severity(Severity.SEVERE)
            .fine(100000, 120000)
            .prison(15, 30)
            .alternativePenalty(true)
            .points(14)
            .drivingBanDays(240)
            .explanation("[L1] Refusing alcohol test -> 100-120k RSD OR prison >= 15 days + 14 points + 8 months ban")
            .build();
        insert(s);
        System.out.println("[FIRED] 24 Refusing alcohol test");
end
