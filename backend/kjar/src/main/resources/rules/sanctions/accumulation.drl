package sanctions;

import com.ftn.sbnz.model.sanctions.Driver;
import com.ftn.sbnz.model.sanctions.RawAggregation;
import com.ftn.sbnz.model.sanctions.Sanction;
import com.ftn.sbnz.model.sanctions.SanctionSummary;
import java.util.ArrayList;
import java.util.List;

// ============================================================
// LAYER 5 - AGREGACIJA (sticaj prekrsaja) - REFAKTORISAN
//
//   L5-raw    - sirovi sumovi + bazni SanctionSummary + RawAggregation
//   L5-cap-min  (idempotent guard: RawAggregation.fineMinCapped == false)
//   L5-cap-max  (idempotent guard: RawAggregation.fineMaxCapped == false)
//   L5-ban    - postavi zakonski max 5 godina; LHS uslov drivingBanMaxDays == 0
//               je sam po sebi idempotent (posle modify-ja vise ne matchuje)
//   L5-prison - dodaj prison explanation (idempotent: prisonExplained == false)
//
// Napomena za L5-raw: ne koristi modify() jer $summary i $raw jos nisu u radnoj
// memoriji - tek se konstruisu i insert-uju. Setteri pre insert-a su validni.
// ============================================================

rule "L5-raw Aggregate raw sums per driver"
    salience 3
    when
        $driver : Driver()
        not SanctionSummary(driver == $driver)
        not RawAggregation(driver == $driver)

        $sumFineMin    : Number() from accumulate(
            Sanction(violation.driver == $driver, $fm : finalFine), sum($fm))
        $sumFineMax    : Number() from accumulate(
            Sanction(violation.driver == $driver, $fM : maxFine),   sum($fM))
        $maxIndFineMin : Number() from accumulate(
            Sanction(violation.driver == $driver, $fm : finalFine), max($fm))
        $maxIndFineMax : Number() from accumulate(
            Sanction(violation.driver == $driver, $fM : maxFine),   max($fM))
        $totalPoints   : Number() from accumulate(
            Sanction(violation.driver == $driver, $p  : finalPoints), sum($p))
        $maxBan        : Number() from accumulate(
            Sanction(violation.driver == $driver, $b  : drivingBanDays), max($b))
        $sumPrison     : Number() from accumulate(
            Sanction(violation.driver == $driver, $pd : prisonDaysMax), sum($pd))
        $list          : List() from collect(Sanction(violation.driver == $driver))
    then
        RawAggregation raw = new RawAggregation(
            $driver,
            $sumFineMin.intValue(),    $sumFineMax.intValue(),
            $maxIndFineMin.intValue(), $maxIndFineMax.intValue(),
            $sumPrison.intValue(),     $maxBan.intValue());
        insert(raw);

        SanctionSummary summary = SanctionSummary.builder()
            .driver($driver)
            .totalFine($sumFineMin.intValue(), $sumFineMax.intValue())
            .totalPoints($totalPoints.intValue())
            .prison($sumPrison.intValue() / 2, $sumPrison.intValue())
            .drivingBan($maxBan.intValue(), 0)
            .sanctions(new ArrayList<Sanction>((List<Sanction>)(List) $list))
            .explanation("[L5] Aggregated " + $list.size()
                + " sanction(s) for driver " + $driver.getFullName()
                + " applying 'sticaj prekrsaja' rules:")
            .explanation("[L5]   Fines (raw sum): "
                + $sumFineMin.intValue() + "-" + $sumFineMax.intValue() + " RSD")
            .explanation("[L5]   Points: " + $totalPoints.intValue())
            .build();
        insert(summary);
        System.out.println("[FIRED] L5-raw aggregation - "
            + $list.size() + " sanction(s), raw fine "
            + $sumFineMin.intValue() + "-" + $sumFineMax.intValue() + " RSD, "
            + $totalPoints.intValue() + " points");
end

// ============================================================
// L5-cap-min : cap-uje totalFineMin ako sum >= 2 x maxIndFineMin.
// Sve izmene $summary (cap + addExplanation) idu u istom modify bloku.
// $raw flag se postavlja u zasebnom modify bloku jer je razlicit fakat.
// Idempotency:
//   - LHS proverava fineMinCapped == false
//   - RHS modify-uje raw flag na true
//   - no-loop true kao dodatna mreza
// ============================================================
rule "L5-cap Apply sticaj cap on totalFineMin"
    salience 3
    no-loop true
    when
        $raw : RawAggregation($driver : driver,
                              fineMinCapped == false,
                              maxIndFineMin > 0,
                              $maxIM : maxIndFineMin,
                              sumFineMin >= 2 * maxIndFineMin)
        $summary : SanctionSummary(driver == $driver)
    then
        int capped = 2 * $maxIM - 1;
        modify($summary) {
            setTotalFineMin(capped),
            addExplanation("[L5-cap] totalFineMin capped to " + capped + " RSD (< 2 x najveca pojedinacna kazna)")
        }
        modify($raw) {
            setFineMinCapped(true)
        }
        System.out.println("[FIRED] L5-cap totalFineMin -> " + capped);
end

// ============================================================
// L5-cap-max : isti princip za totalFineMax.
// ============================================================
rule "L5-cap Apply sticaj cap on totalFineMax"
    salience 3
    no-loop true
    when
        $raw : RawAggregation($driver : driver,
                              fineMaxCapped == false,
                              maxIndFineMax > 0,
                              $maxIM : maxIndFineMax,
                              sumFineMax >= 2 * maxIndFineMax)
        $summary : SanctionSummary(driver == $driver)
    then
        int capped = 2 * $maxIM - 1;
        modify($summary) {
            setTotalFineMax(capped),
            addExplanation("[L5-cap] totalFineMax capped to " + capped + " RSD")
        }
        modify($raw) {
            setFineMaxCapped(true)
        }
        System.out.println("[FIRED] L5-cap totalFineMax -> " + capped);
end

// ============================================================
// L5-ban : postavi zakonski max 5 godina (1825 dana) i dodaj explanation.
// Idempotency: LHS trazi drivingBanMaxDays == 0 (sirovo stanje iz L5-raw).
// Posle modify-ja drivingBanMaxDays = 1825, pa LHS vise ne matchuje.
// ============================================================
rule "L5-ban Set driving ban legal max and explanation"
    salience 3
    no-loop true
    when
        $summary : SanctionSummary(drivingBanMinDays > 0,
                                   drivingBanMaxDays == 0,
                                   $minBan : drivingBanMinDays)
    then
        modify($summary) {
            setDrivingBanMaxDays(1825),
            addExplanation("[L5]   Driving ban: " + $minBan + " - 1825 days (najveci pojedinacni minimum -> zakonski cap 5 godina)")
        }
        System.out.println("[FIRED] L5-ban driving ban max -> 1825");
end

// ============================================================
// L5-prison : dodaj prison explanation kad postoji zatvor.
// Idempotency preko flag-a na RawAggregation (LHS prisonExplained == false,
// RHS postavi na true preko modify-ja).
// addExplanation na $summary ide kroz modify($summary) blok.
// ============================================================
rule "L5-prison Add prison explanation"
    salience 3
    no-loop true
    when
        $raw : RawAggregation($driver : driver,
                              prisonExplained == false,
                              sumPrison > 0)
        $summary : SanctionSummary(driver == $driver,
                                   prisonMaxDays > 0,
                                   $pMin : prisonMinDays,
                                   $pMax : prisonMaxDays)
    then
        modify($summary) {
            addExplanation("[L5]   Prison: " + $pMin + " - " + $pMax + " days")
        }
        modify($raw) {
            setPrisonExplained(true)
        }
        System.out.println("[FIRED] L5-prison explanation added");
end
