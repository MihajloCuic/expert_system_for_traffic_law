package sanctions;

import com.ftn.sbnz.model.sanctions.Driver;
import com.ftn.sbnz.model.sanctions.Sanction;
import com.ftn.sbnz.model.sanctions.SanctionSummary;

import java.util.ArrayList;
import java.util.List;

// ============================================================
// LAYER 5 - ACCUMULATION (sticaj prekrsaja)
//
// Combines all individual Sanctions for one driver into a single SanctionSummary
// using the rules from the Serbian Law on Misdemeanors:
//
//   FINES  - sum of all sanctions' fines, BUT the total must be strictly LESS THAN
//            double the highest single fine. Example: fines 10k+20k+30k = 60k, but 2*30k = 60k,
//            so capped at 59 999.
//
//   POINTS - simple sum.
//
//   BAN    - judge can sentence anywhere between:
//              MIN = the highest single mandatory minimum ban
//              MAX = 5 years (1825 days), legal cap, only when any ban applies
//
//   PRISON - judge sentences between (sum / 2) and the full sum.
//
// salience 3 ensures this runs AFTER Dedup (5) and Accident escalation (4).
// The summary therefore reflects deduplicated, escalated values.
// ============================================================

rule "Aggregate sanctions per driver (sticaj prekrsaja)"
    salience 3
    when
        $driver : Driver()
        not SanctionSummary(driver == $driver)

        // Sum of fines (lower bound of total)
        $sumFineMin : Number() from accumulate(
            Sanction(violation.driver == $driver, $fm : finalFine),
            sum($fm))

        // Sum of fines (upper bound of total)
        $sumFineMax : Number() from accumulate(
            Sanction(violation.driver == $driver, $fM : maxFine),
            sum($fM))

        // Highest single fine (for the cap)
        $maxIndFineMin : Number() from accumulate(
            Sanction(violation.driver == $driver, $fm : finalFine),
            max($fm))

        $maxIndFineMax : Number() from accumulate(
            Sanction(violation.driver == $driver, $fM : maxFine),
            max($fM))

        // Total penalty points
        $totalPoints : Number() from accumulate(
            Sanction(violation.driver == $driver, $p : finalPoints),
            sum($p))

        // Driving ban: highest single mandatory minimum
        $maxIndBan : Number() from accumulate(
            Sanction(violation.driver == $driver, $b : drivingBanDays),
            max($b))

        // Prison: sum of individual maximums (then sum/2 .. sum)
        $sumPrison : Number() from accumulate(
            Sanction(violation.driver == $driver, $pd : prisonDaysMax),
            sum($pd))

        // List of all Sanctions for the explanation trail
        $list : List() from collect(Sanction(violation.driver == $driver))
    then
        SanctionSummary summary = new SanctionSummary();
        summary.setDriver($driver);

        // ----- FINE: apply sticaj cap (total < 2 x max single fine) -----
        int sumFineMin = $sumFineMin.intValue();
        int sumFineMax = $sumFineMax.intValue();
        int maxIndFineMin = $maxIndFineMin.intValue();
        int maxIndFineMax = $maxIndFineMax.intValue();

        int totalFineMin = sumFineMin;
        if (maxIndFineMin > 0 && sumFineMin >= 2 * maxIndFineMin) {
            totalFineMin = 2 * maxIndFineMin - 1;
        }
        int totalFineMax = sumFineMax;
        if (maxIndFineMax > 0 && sumFineMax >= 2 * maxIndFineMax) {
            totalFineMax = 2 * maxIndFineMax - 1;
        }
        summary.setTotalFineMin(totalFineMin);
        summary.setTotalFineMax(totalFineMax);

        // ----- POINTS: simple sum -----
        summary.setTotalPoints($totalPoints.intValue());

        // ----- DRIVING BAN: max of individual minimums; legal cap 5 years -----
        int maxBan = $maxIndBan.intValue();
        if (maxBan > 0) {
            summary.setDrivingBanMinDays(maxBan);
            summary.setDrivingBanMaxDays(1825);
        } else {
            summary.setDrivingBanMinDays(0);
            summary.setDrivingBanMaxDays(0);
        }

        // ----- PRISON: sum/2 .. sum -----
        int sumPrison = $sumPrison.intValue();
        summary.setPrisonMinDays(sumPrison / 2);
        summary.setPrisonMaxDays(sumPrison);

        // ----- Sanction list for the explanation trail -----
        List<Sanction> sList = new ArrayList<>();
        for (Object o : $list) { sList.add((Sanction) o); }
        summary.setSanctions(sList);

        // ----- Build the explanation -----
        summary.addExplanation("[L5] Aggregated " + sList.size()
            + " sanction(s) for driver " + $driver.getFullName()
            + " applying 'sticaj prekrsaja' rules:");
        boolean capApplied = (totalFineMin != sumFineMin) || (totalFineMax != sumFineMax);
        summary.addExplanation("[L5]   Fines: sum " + sumFineMin + "-" + sumFineMax + " RSD"
            + (capApplied
                ? " -> capped to " + totalFineMin + "-" + totalFineMax + " RSD"
                : " (no cap needed)"));
        summary.addExplanation("[L5]   Points: " + summary.getTotalPoints());
        if (maxBan > 0) {
            summary.addExplanation("[L5]   Driving ban: "
                + summary.getDrivingBanMinDays() + " - " + summary.getDrivingBanMaxDays() + " days"
                + " (highest individual minimum -> legal cap 5 years)");
        }
        if (sumPrison > 0) {
            summary.addExplanation("[L5]   Prison: "
                + summary.getPrisonMinDays() + " - " + summary.getPrisonMaxDays() + " days");
        }

        insert(summary);
        System.out.println("[FIRED] Layer 5 accumulation - "
            + sList.size() + " sanction(s), total fine "
            + summary.getTotalFineMin() + "-" + summary.getTotalFineMax() + " RSD"
            + ", " + summary.getTotalPoints() + " points");
end
