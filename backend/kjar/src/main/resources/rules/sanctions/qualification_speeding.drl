        $v : Violation(type == ViolationType.SPEEDING,
                       location == Location.SCHOOL_ZONE,
                       speedOverLimitKmH > 60)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 45 (school zone, penal art. 330)")
            .severity(Severity.SEVERE)
            .fine(100000, 120000)
            .prison(15, 30)
            .alternativePenalty(true)
            .points(14)
            .drivingBanDays(240)
