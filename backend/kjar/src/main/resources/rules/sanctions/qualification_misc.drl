            .build();
        s.addExplanation("[L1] Failure to report accident -> 10-20k RSD");
        insert(s);
        System.out.println("[FIRED] 51 Failure to report accident");
end

// --- Parking (52-55) ---

rule "52 Parking on pedestrian crossing"
    salience 7
    when
        $v : Violation(type == ViolationType.PARKING_ON_PEDESTRIAN_CROSSING)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 66 par. 1 pt. 1 (penal art. 333)")
            .severity(Severity.MINOR)
            .fixedFine(5000)
            .build();
        s.addExplanation("[L1] Parking on pedestrian crossing -> 5.000 RSD");
        insert(s);
        System.out.println("[FIRED] 52 Parking on pedestrian crossing");
end

