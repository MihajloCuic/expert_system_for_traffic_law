package sanctions;

import com.ftn.sbnz.model.Violation;
import com.ftn.sbnz.model.Sanction;
import com.ftn.sbnz.model.ViolationType;
import com.ftn.sbnz.model.Severity;

// ============================================================
// LAYER 1 - LICENSE (48-49), ACCIDENT (50-51),
//           PARKING (52-55), MISC (56-58)
// ============================================================

// --- License (48-49) ---

rule "48 Driving without license"
    salience 7
    when
        $v : Violation(type == ViolationType.NO_LICENSE)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 330 par. 1 pt. 1 (never licensed or license revoked)")
            .severity(Severity.SEVERE)
            .fine(100000, 120000)
            .prison(15, 30)
            .alternativePenalty(true)
            .points(14)
            .drivingBanDays(240)
            .build();
        s.addExplanation("[L1] Driving without license -> 100-120k RSD OR prison >= 15 days + 14 points + 8 months ban");
        insert(s);
        System.out.println("[FIRED] 48 No license");
end

rule "49 Wrong license category"
    salience 7
    when
        $v : Violation(type == ViolationType.WRONG_LICENSE_CATEGORY)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 178 par. 1 (penal art. 331)")
            .severity(Severity.MAJOR)
            .fine(20000, 40000)
            .prison(0, 30)
            .alternativePenalty(true)
            .build();
        s.addExplanation("[L1] Wrong license category -> 20-40k RSD OR prison <= 30 days");
        insert(s);
        System.out.println("[FIRED] 49 Wrong license category");
end

// --- Accident (50-51) ---

rule "50 Fleeing scene of accident"
    salience 7
    when
        $v : Violation(type == ViolationType.FLEEING_SCENE)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 330")
            .severity(Severity.SEVERE)
            .fine(100000, 120000)
            .prison(15, 30)
            .alternativePenalty(true)
            .points(14)
            .drivingBanDays(240)
            .build();
        s.addExplanation("[L1] Fleeing scene of accident -> 100-120k RSD OR prison >= 15 days + 14 points + 8 months ban");
        insert(s);
        System.out.println("[FIRED] 50 Fleeing scene");
end

rule "51 Failure to report accident"
    salience 7
    when
        $v : Violation(type == ViolationType.FAILURE_TO_REPORT_ACCIDENT)
    then
        Sanction s = Sanction.builder()
            .violation($v)
            .lawArticle("ZOBS art. 167 (penal art. 332)")
            .severity(Severity.MODERATE)
