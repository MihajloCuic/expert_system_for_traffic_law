package fault;

import com.ftn.sbnz.model.fault.Participant;
import com.ftn.sbnz.model.fault.Fault;
import com.ftn.sbnz.model.fault.Blame;
import com.ftn.sbnz.model.fault.BlameType;

// ============================================================
// LAYER 2 – Causality and blame distribution
// Salience -6: fires after Layer 1 (salience 0).
// ============================================================

rule "L2 Blame EXCLUSIVE – only one participant has faults"
    salience -6
    when
        $p : Participant()
        not Blame(participant.id == $p.id)
        Number(intValue() > 0) from accumulate(
            Fault(participant == $p, $w : weight), sum($w)
        )
        Number(intValue() == 0) from accumulate(
            Fault(participant.id != $p.id, $w2 : weight), sum($w2)
        )
    then
        Blame blame = new Blame($p, 100, BlameType.EXCLUSIVE);
        insert(blame);
        System.out.println("[FIRED] Layer2 EXCLUSIVE blame for " + $p.getId());
end

// Pravilo za PREDOMINANT: ucesnik ima >= 70% ukupnih tezina
rule "L2 Blame PREDOMINANT – participant weight >= 70 percent"
    salience -6
    when
        $p : Participant()
        not Blame(participant.id == $p.id)
        $weight : Number(intValue() > 0) from accumulate(
            Fault(participant == $p, $w : weight), sum($w)
        )
        $grandTotal : Number(intValue() > 0) from accumulate(
            Fault($w3 : weight), sum($w3)
        )
        // Postoji bar jos jedan ucesnik sa propustima (inace je EXCLUSIVE)
        Number(intValue() > 0) from accumulate(
            Fault(participant.id != $p.id, $w4 : weight), sum($w4)
        )
        eval( (100.0 * $weight.intValue() / $grandTotal.intValue()) >= 70.0 )
    then
        int pct = (int) Math.round(100.0 * $weight.intValue() / $grandTotal.intValue());
        Blame blame = new Blame($p, pct, BlameType.PREDOMINANT);
        insert(blame);
        System.out.println("[FIRED] Layer2 PREDOMINANT blame " + $p.getId() + " pct=" + pct);
end

// Pravilo za SHARED: ucesnik ima < 70% ukupnih tezina
rule "L2 Blame SHARED – participant weight under 70 percent"
    salience -6
    when
        $p : Participant()
        not Blame(participant.id == $p.id)
        $weight : Number(intValue() > 0) from accumulate(
            Fault(participant == $p, $w : weight), sum($w)
        )
        $grandTotal : Number(intValue() > 0) from accumulate(
            Fault($w3 : weight), sum($w3)
        )
        // Postoji bar jos jedan ucesnik sa propustima (inace je EXCLUSIVE)
        Number(intValue() > 0) from accumulate(
            Fault(participant.id != $p.id, $w4 : weight), sum($w4)
        )
        eval( (100.0 * $weight.intValue() / $grandTotal.intValue()) < 70.0 )
    then
        int pct = (int) Math.round(100.0 * $weight.intValue() / $grandTotal.intValue());
        Blame blame = new Blame($p, pct, BlameType.SHARED);
        insert(blame);
        System.out.println("[FIRED] Layer2 SHARED blame " + $p.getId() + " pct=" + pct);
end

rule "L2 Blame NONE – no faults"
    salience -9
    when
        $p : Participant()
        not Blame(participant.id == $p.id)
        Number(intValue() == 0) from accumulate(
            Fault(participant == $p, $w : weight), sum($w)
        )
    then
        Blame blame = new Blame($p, 0, BlameType.NONE);
        insert(blame);
        System.out.println("[FIRED] Layer2 NONE blame for " + $p.getId());
end
