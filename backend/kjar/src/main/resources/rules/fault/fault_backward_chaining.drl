package fault;

import com.ftn.sbnz.model.fault.Participant;
import com.ftn.sbnz.model.fault.Fault;
import com.ftn.sbnz.model.fault.Blame;
import com.ftn.sbnz.model.fault.BlameType;
import com.ftn.sbnz.model.fault.CausedFault;

query "directlyAtFault"(String $participantId)
    Fault(participant.id == $participantId, causedAccident == true)
end

// Non-recursive: covers the direct two-step chain A -> B.
// Full recursive variant caused infinite loops in Drools because the recursive
// branch had no provable termination condition for all Participant permutations.
query "responsibleForAccident"(String $aId, String $bId)
    directlyAtFault($bId;)
    CausedFault(cause.id == $aId, consequence.participant.id == $bId)
end

rule "Indirect blame through chain"
    salience -8
    when
        $a : Participant($aId : id)
        $b : Participant($bId : id, id != $aId)
        responsibleForAccident($aId, $bId;)
        not Blame(participant.id == $aId)
    then
        Blame blame = new Blame($a, 0, BlameType.INDIRECT);
        blame.addReasoning("[Backward Chaining] caused chain via " + $aId);
        insert(blame);
        System.out.println("[FIRED] BackwardChaining INDIRECT blame for "
            + $aId + " via chain to " + $bId);
end
